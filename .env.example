# Official site origin (used for docs, release notes, plugin marketplace, and tunnel installer)
VIBEX_SITE_URL=https://vibex.xforever.xin

# Local Apple signing for `pnpm run dev` and `pnpm run tauri:build`.
# Copy to `.env.local` (gitignored) and fill in your Developer ID details.
# Existing environment variables always win over this file.

APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)
APPLE_API_KEY=
APPLE_API_ISSUER=
APPLE_API_KEY_PATH=
APPLE_TEAM_ID=

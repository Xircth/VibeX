{
  "$schema": "vibex-plugin/v2",
  "id": "vibex.office",
  "version": "2.0.0",
  "name": "VibeX Office",
  "description": "Create, edit, analyze, and preview PPTX, DOCX, and XLSX artifacts.",
  "author": "VibeX",
  "builtin": true,
  "dependencies": [
    {
      "id": "officecli",
      "kind": "binary",
      "version": "1.0.140",
      "distributions": {
        "aarch64-apple-darwin": {
          "url": "https://github.com/iOfficeAI/OfficeCLI/releases/download/v1.0.140/officecli-mac-arm64",
          "sha256": "d83d68a6138c9a8456707db86f9ff62813a2d752d08ea725b3c8f077950086ba"
        },
        "x86_64-apple-darwin": {
          "url": "https://github.com/iOfficeAI/OfficeCLI/releases/download/v1.0.140/officecli-mac-x64",
          "sha256": "61b864e628d0cf4e203b2b8e679bccdaf657e0328d54f17d08173181a2adba13"
        },
        "aarch64-unknown-linux-gnu": {
          "url": "https://github.com/iOfficeAI/OfficeCLI/releases/download/v1.0.140/officecli-linux-arm64",
          "sha256": "924dd58f57891d1b3fe8cf77f06990f58f8f0c0ddf6fe22e1d91c7f10d3e7576"
        },
        "x86_64-unknown-linux-gnu": {
          "url": "https://github.com/iOfficeAI/OfficeCLI/releases/download/v1.0.140/officecli-linux-x64",
          "sha256": "cee68cc2108074e5ae5ad114e1cd5cab4514da8ead4983d5d94aa0acba4f41e8"
        },
        "aarch64-pc-windows-msvc": {
          "url": "https://github.com/iOfficeAI/OfficeCLI/releases/download/v1.0.140/officecli-win-arm64.exe",
          "sha256": "a83bcfbab9a092dd060d6016168c42a639865d198ef6aa3772dd196109433551"
        },
        "x86_64-pc-windows-msvc": {
          "url": "https://github.com/iOfficeAI/OfficeCLI/releases/download/v1.0.140/officecli-win-x64.exe",
          "sha256": "43ad45527bf2c486da1dd7c8d9257b90ac17a6b83028d7064ea38235cd43ec3e"
        }
      },
      "probe": ["--version"]
    }
  ],
  "skills": [
    {
      "id": "office-pptx",
      "source": "bundled",
      "path": "skills/office-pptx"
    },
    {
      "id": "office-docx",
      "source": "bundled",
      "path": "skills/office-docx"
    },
    {
      "id": "office-xlsx",
      "source": "bundled",
      "path": "skills/office-xlsx"
    }
  ],
  "actions": [
    {
      "id": "create-presentation",
      "label": "创建 PPT",
      "requiredSkills": ["office-pptx"],
      "requiredTools": ["officecli"],
      "promptBlocks": [{"type": "text", "text": "澄清受众与目标后，创建新的 PPTX 并验证输出。"}],
      "artifactIntent": {
        "mediaTypes": ["application/vnd.openxmlformats-officedocument.presentationml.presentation"],
        "provider": "officecli"
      }
    },
    {
      "id": "modify-presentation",
      "label": "修改 PPT",
      "requiredSkills": ["office-pptx"],
      "requiredTools": ["officecli"],
      "promptBlocks": [{"type": "text", "text": "按要求修改现有 PPTX，保留未指定内容并验证输出。"}],
      "artifactIntent": {
        "mediaTypes": ["application/vnd.openxmlformats-officedocument.presentationml.presentation"],
        "provider": "officecli"
      }
    },
    {
      "id": "create-document",
      "label": "创建 DOCX",
      "requiredSkills": ["office-docx"],
      "requiredTools": ["officecli"],
      "promptBlocks": [{"type": "text", "text": "根据用户目标创建结构清晰的 DOCX 并验证输出。"}],
      "artifactIntent": {
        "mediaTypes": ["application/vnd.openxmlformats-officedocument.wordprocessingml.document"],
        "provider": "officecli"
      }
    },
    {
      "id": "modify-document",
      "label": "修改 DOCX",
      "requiredSkills": ["office-docx"],
      "requiredTools": ["officecli"],
      "promptBlocks": [{"type": "text", "text": "按要求修改现有 DOCX，保留未指定内容并验证输出。"}],
      "artifactIntent": {
        "mediaTypes": ["application/vnd.openxmlformats-officedocument.wordprocessingml.document"],
        "provider": "officecli"
      }
    },
    {
      "id": "analyze-spreadsheet",
      "label": "分析 Excel",
      "requiredSkills": ["office-xlsx"],
      "requiredTools": ["officecli"],
      "promptBlocks": [{"type": "text", "text": "检查工作表结构和数据质量，分析 XLSX 并给出可追溯结论。"}],
      "artifactIntent": {
        "mediaTypes": ["application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"],
        "provider": "officecli"
      }
    },
    {
      "id": "generate-spreadsheet",
      "label": "生成 Excel",
      "requiredSkills": ["office-xlsx"],
      "requiredTools": ["officecli"],
      "promptBlocks": [{"type": "text", "text": "根据用户需求生成 XLSX，校验公式、格式与关键结果。"}],
      "artifactIntent": {
        "mediaTypes": ["application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"],
        "provider": "officecli"
      }
    }
  ]
}

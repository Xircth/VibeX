{
  "$schema": "https://schemas.vibex.dev/plugin/v4/plugin.schema.json",
  "manifestVersion": 4,
  "apiVersion": "1.0",
  "id": "vibex.open-connector",
  "publisher": "vibex",
  "version": "1.0.0",
  "name": "Open Connector",
  "readme": "README.md",
  "engines": {
    "vibex": ">=0.1.3 <1.0.0",
    "pluginSdk": "^1.0.0"
  },
  "content": {
    "root": "contents",
    "index": ".vibex-plugin/content.index.json"
  },
  "config": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalogLazySchemas": { "type": "boolean" },
        "allowPrivateNetwork": { "type": "boolean" },
        "trustedHosts": { "type": "string" }
      }
    }
  },
  "dependencies": [
    {
      "kind": "runtime",
      "descriptor": "depends/runtimes/open-connector.json"
    }
  ],
  "entrypoints": {
    "worker": {
      "path": "dist/worker.mjs",
      "runtime": "node",
      "protocol": "1.1"
    },
    "app": {
      "root": "dist/app",
      "document": "index.html",
      "protocol": "1.0"
    }
  },
  "integrations": [
    {
      "id": "console",
      "kind": "app.tab",
      "title": "Open Connector",
      "icon": "plug",
      "handler": "surface.createSession",
      "hidesBottomDock": true,
      "remote": {
        "name": "open_connector",
        "entry": "dist/remoteEntry.js",
        "module": "./view"
      }
    },
    {
      "id": "settings",
      "kind": "app.surface",
      "label": "Open Connector",
      "slot": "plugin.detail.panel",
      "appEntrypoint": "app",
      "handler": "surface.createSession",
      "allowedMethods": [
        "surface.createSession",
        "runtime.status",
        "runtime.statusText",
        "runtime.restart",
        "runtime.health",
        "runtime.wipeData",
        "mcp.endpoint"
      ],
      "minHeight": 420
    },
    {
      "id": "mcp",
      "kind": "content.mcp",
      "resource": "contents/mcps/open-connector.json"
    },
    {
      "id": "skill",
      "kind": "content.skill",
      "resource": "contents/skills/open-connector"
    },
    {
      "id": "runtime-status",
      "kind": "app.status",
      "slot": "status.main",
      "text": "Open Connector",
      "icon": "plug",
      "handler": "runtime.statusText",
      "refreshSeconds": 15
    },
    {
      "id": "runtime-status-command",
      "kind": "app.command",
      "title": "Open Connector 状态",
      "subtitle": "查看本机连接器是否在运行",
      "icon": "plug",
      "handler": "runtime.statusText"
    },
    {
      "id": "health",
      "kind": "host.service",
      "handler": "runtime.health",
      "intervalSeconds": 15
    }
  ],
  "interface": {
    "icon": "assets/icon.svg"
  }
}

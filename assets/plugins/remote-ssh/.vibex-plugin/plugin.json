{
  "$schema": "https://schemas.vibex.dev/plugin/v4/plugin.schema.json",
  "manifestVersion": 4,
  "apiVersion": "1.0",
  "id": "vibex.remote-ssh",
  "publisher": "vibex",
  "version": "1.0.2",
  "name": "Remote SSH",
  "readme": "README.md",
  "engines": {
    "vibex": ">=0.1.3 <1.0.0",
    "pluginSdk": "^1.0.0"
  },
  "content": {
    "root": "contents",
    "index": ".vibex-plugin/content.index.json"
  },
  "config": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "user": { "type": "string" },
        "jump": { "type": "string" },
        "dataDir": { "type": "string" },
        "rememberPassword": { "type": "boolean" }
      }
    }
  },
  "entrypoints": {
    "worker": {
      "path": "dist/worker.mjs",
      "runtime": "node",
      "protocol": "1.1"
    },
    "app": {
      "root": "dist/app",
      "document": "index.html",
      "protocol": "1.0"
    }
  },
  "integrations": [
    {
      "id": "connect-panel",
      "kind": "app.surface",
      "label": "Remote SSH",
      "slot": "plugin.detail.panel",
      "appEntrypoint": "app",
      "handler": "surface.createSession",
      "allowedMethods": [
        "session.start",
        "session.status",
        "session.cancel",
        "session.load",
        "session.history",
        "session.historySave",
        "session.test",
        "provision.ensure"
      ],
      "minHeight": 640
    },
    {
      "id": "ssh",
      "kind": "provider.remote.provisioner",
      "provisionKind": "ssh",
      "label": "SSH",
      "icon": "cloud",
      "handler": "provision.ensure",
      "timeoutSeconds": 300
    }
  ],
  "interface": {
    "icon": "assets/icon.svg"
  }
}

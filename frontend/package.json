{
  "name": "vibex",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:e2e": "tsc && vite build --config vite.e2e.config.ts",
    "test:e2e:web": "pnpm run build:e2e && tsc --noEmit -p tsconfig.e2e.json && cargo build --manifest-path ../Cargo.toml -p server --bin vibex-server && playwright test --config playwright.config.ts"
  },

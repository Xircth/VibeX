{
  "name": "vibex",
  "version": "0.1.8",
  "private": true,
  "bin": {
    "vibex": "npx-cli/bin/cli.js"
  },
  "files": [
    "npx-cli/bin/cli.js",
    "npx-cli/dist/**"
  ],
  "scripts": {
    "lint": "pnpm run frontend:lint && pnpm run backend:lint",
    "format": "cargo fmt --all && cd frontend && pnpm run format",
    "check": "pnpm run frontend:check && pnpm run backend:check",
    "dev": "pnpm run dev:desktop",
    "dev:desktop": "pnpm run tauri:dev:desktop",
    "frontend:build": "cd frontend && pnpm run build",
    "frontend:lint": "cd frontend && pnpm run lint",
    "frontend:check": "cd frontend && pnpm run check",
    "backend:lint": "cargo clippy --workspace --all-targets --features qa-mode -- -D warnings",
    "backend:dev": "node scripts/run-backend-standalone.js",
    "backend:check": "cargo check",
    "backend:dev:watch": "node scripts/run-backend-dev.js",
    "generate-types": "node scripts/run-generate-types.js",
    "generate-types:check": "node scripts/run-generate-types.js --check",
    "prepare-db": "node scripts/prepare-db.js",
    "prepare-db:check": "node scripts/prepare-db.js --check",
    "tauri:dev": "pnpm run tauri:dev:desktop",
    "tauri:dev:desktop": "node scripts/run-tauri-dev-desktop.js",
    "tauri:build": "node scripts/run-tauri-build.js",
    "tauri:build:windows": "node scripts/run-tauri-build.js --bundles msi,nsis",
    "tauri:build:macos": "node scripts/run-tauri-build.js --bundles app,dmg",
    "tauri:build:linux": "node scripts/run-tauri-build.js --bundles appimage,deb",
    "tauri:build:all": "node scripts/run-tauri-build-all.js",
    "test:updater-manifest": "node --test scripts/generate-updater-manifest.test.js",
    "test:cef:bundle:macos": "node scripts/smoke-cef-bundle-macos.js",
    "test:web:e2e": "cd frontend && pnpm run test:e2e:web"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "concurrently": "^8.2.2",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.23"
  }
}

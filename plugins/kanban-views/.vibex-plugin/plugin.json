{
  "manifestVersion": 4,
  "apiVersion": "2.0",
  "id": "vibex.kanban-views",
  "publisher": "vibex",
  "name": "Kanban Views",
  "version": "2.0.0",
  "description": "Built-in Kanban board views, sprint velocity metrics, and task grouping presets.",
  "readme": "README.md",
  "interface": {
    "icon": "assets/icon.svg"
  },
  "content": {
    "root": "contents",
    "index": ".vibex-plugin/content.index.json"
  },
  "engines": {
    "vibex": ">=0.1.3 <1.0.0",
    "pluginSdk": "^2.0.0"
  },
  "entrypoints": {
    "app": {
      "entry": "app/main.js",
      "protocol": "2.0"
    }
  },
  "integrations": [
    {
      "id": "kanban-triage",
      "kind": "content.skill",
      "resource": "contents/skills/kanban-triage"
    },
    {
      "id": "kanban-filter-command",
      "kind": "app.command",
      "label": "Filter Kanban Tasks"
    }
  ]
}

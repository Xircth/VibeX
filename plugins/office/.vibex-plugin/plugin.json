{
  "$schema": "https://schemas.vibex.dev/plugin/v4/plugin.schema.json",
  "manifestVersion": 4,
  "apiVersion": "2.0",
  "id": "vibex.office",
  "publisher": "vibex",
  "version": "3.0.0",
  "name": "VibeX Office",
  "readme": "README.md",
  "engines": {
    "vibex": ">=0.1.3 <1.0.0",
    "pluginSdk": "^2.0.0"
  },
  "content": {
    "root": "contents",
    "index": ".vibex-plugin/content.index.json"
  },
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "idleTimeoutMinutes": {
          "title": "空闲后停止预览",
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 10
        }
      },
      "additionalProperties": false
    }
  },
  "dependencies": [
    {
      "kind": "runtime",
      "descriptor": "depends/runtimes/officecli.json"
    }
  ],
  "entrypoints": {
    "worker": {
      "path": "dist/worker.mjs",
      "runtime": "node",
      "protocol": "1.1"
    },
    "app": {
      "entry": "app/main.js",
      "protocol": "2.0"
    }
  },
  "integrations": [
    {
      "id": "pptx",
      "kind": "content.skill",
      "resource": "contents/skills/pptx",
      "targets": [
        "codex",
        "claude-code",
        "acp"
      ]
    },
    {
      "id": "word",
      "kind": "content.skill",
      "resource": "contents/skills/word",
      "targets": [
        "codex",
        "claude-code",
        "acp"
      ]
    },
    {
      "id": "excel",
      "kind": "content.skill",
      "resource": "contents/skills/excel",
      "targets": [
        "codex",
        "claude-code",
        "acp"
      ]
    },
    {
      "id": "morph-ppt",
      "kind": "content.skill",
      "resource": "contents/skills/morph-ppt",
      "targets": [
        "codex",
        "claude-code",
        "acp"
      ]
    },
    {
      "id": "morph-ppt-3d",
      "kind": "content.skill",
      "resource": "contents/skills/morph-ppt-3d",
      "targets": [
        "codex",
        "claude-code",
        "acp"
      ]
    },
    {
      "id": "pitch-deck",
      "kind": "content.skill",
      "resource": "contents/skills/pitch-deck",
      "targets": [
        "codex",
        "claude-code",
        "acp"
      ]
    },
    {
      "id": "academic-paper",
      "kind": "content.skill",
      "resource": "contents/skills/academic-paper",
      "targets": [
        "codex",
        "claude-code",
        "acp"
      ]
    },
    {
      "id": "data-dashboard",
      "kind": "content.skill",
      "resource": "contents/skills/data-dashboard",
      "targets": [
        "codex",
        "claude-code",
        "acp"
      ]
    },
    {
      "id": "financial-model",
      "kind": "content.skill",
      "resource": "contents/skills/financial-model",
      "targets": [
        "codex",
        "claude-code",
        "acp"
      ]
    },
    {
      "id": "word-form",
      "kind": "content.skill",
      "resource": "contents/skills/word-form",
      "targets": [
        "codex",
        "claude-code",
        "acp"
      ]
    },
    {
      "id": "create-presentation",
      "kind": "workflow.binding",
      "resource": "contents/workflows/create-presentation/workflow.json"
    },
    {
      "id": "modify-presentation",
      "kind": "workflow.binding",
      "resource": "contents/workflows/modify-presentation/workflow.json"
    },
    {
      "id": "create-document",
      "kind": "workflow.binding",
      "resource": "contents/workflows/create-document/workflow.json"
    },
    {
      "id": "modify-document",
      "kind": "workflow.binding",
      "resource": "contents/workflows/modify-document/workflow.json"
    },
    {
      "id": "analyze-spreadsheet",
      "kind": "workflow.binding",
      "resource": "contents/workflows/analyze-spreadsheet/workflow.json"
    },
    {
      "id": "generate-spreadsheet",
      "kind": "workflow.binding",
      "resource": "contents/workflows/generate-spreadsheet/workflow.json"
    },
    {
      "id": "office-file-opener",
      "kind": "file.opener",
      "label": "Office Preview",
      "extensions": [
        "docx",
        "xlsx",
        "pptx"
      ],
      "mediaTypes": [
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      ],
      "priority": 100,
      "previewProvider": "office-preview"
    },
    {
      "id": "office-preview",
      "kind": "artifact.preview",
      "mediaTypes": [
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      ],
      "runtime": "officecli",
      "maxConcurrentPreviews": 4,
      "handler": "office-preview",
      "process": {
        "argv": [
          "watch",
          "{artifact}",
          "--port",
          "{port}"
        ],
        "readyTimeoutSeconds": 15,
        "environment": {
          "OFFICECLI_SKIP_UPDATE": "1"
        }
      }
    }
  ],
  "interface": {
    "icon": "assets/icon.svg"
  }
}

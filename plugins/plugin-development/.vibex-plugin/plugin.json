{
  "$schema": "https://schemas.vibex.dev/plugin/v4/plugin.schema.json",
  "manifestVersion": 4,
  "apiVersion": "2.0",
  "id": "vibex.plugin-development",
  "publisher": "vibex",
  "version": "1.2.0",
  "name": "插件开发",
  "readme": "README.md",
  "engines": {
    "vibex": ">=0.1.3 <1.0.0",
    "pluginSdk": "^2.0.0"
  },
  "content": {
    "root": "contents",
    "index": ".vibex-plugin/content.index.json"
  },
  "config": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  },
  "integrations": [
    {
      "id": "vibex-plugin-development",
      "kind": "content.skill",
      "resource": "contents/skills/vibex-plugin-development",
      "targets": [
        "codex",
        "claude-code",
        "acp"
      ]
    }
  ],
  "interface": {
    "icon": "assets/icon.svg"
  },
  "entrypoints": {
    "app": {
      "entry": "app/main.js",
      "protocol": "2.0"
    }
  }
}

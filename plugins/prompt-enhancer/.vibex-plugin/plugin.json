{
  "manifestVersion": 4,
  "apiVersion": "2.0",
  "id": "vibex.prompt-enhancer",
  "publisher": "vibex",
  "name": "Prompt Enhancer",
  "version": "2.0.0",
  "description": "Built-in prompt refinement, @enhance composer action, and structured context enrichment.",
  "readme": "README.md",
  "content": {
    "root": "contents",
    "index": ".vibex-plugin/content.index.json"
  },
  "engines": {
    "vibex": ">=0.1.3 <1.0.0",
    "pluginSdk": "^2.0.0"
  },
  "entrypoints": {
    "app": {
      "entry": "app/main.js",
      "protocol": "2.0"
    }
  },
  "integrations": [
    {
      "id": "prompt-refinement",
      "kind": "content.skill",
      "resource": "contents/skills/prompt-refinement"
    },
    {
      "id": "enhance-prompt-command",
      "kind": "app.command",
      "label": "Enhance Composer Prompt"
    }
  ]
}

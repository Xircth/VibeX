{
  "$schema": "https://schemas.vibex.dev/plugin/v4/plugin.schema.json",
  "manifestVersion": 4,
  "apiVersion": "2.0",
  "id": "vibex.science",
  "publisher": "vibex",
  "version": "1.0.0",
  "name": "科学研究",
  "readme": "README.md",
  "engines": {
    "vibex": ">=0.1.3 <1.0.0",
    "pluginSdk": "^2.0.0"
  },
  "content": {
    "root": "contents",
    "index": ".vibex-plugin/content.index.json"
  },
  "config": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains"
      ],
      "properties": {
        "domains": {
          "type": "object",
          "title": "技能领域",
          "description": "按领域启用技能。关闭的领域不会把技能注入任何 Agent；默认只启用「通用科研方法」。",
          "properties": {
            "general": {
              "type": "boolean",
              "title": "通用科研方法",
              "description": "选题构思、假设、实验设计、统计功效与检验、探索性数据分析、科学可视化、批判性思维、文献检索、同行评审、引文管理、成果评估、科研示意图。默认开启。（13 项技能）"
            },
            "literature": {
              "type": "boolean",
              "title": "文献检索与信息获取",
              "description": "跨学术文献、网页、公共数据库与本体/知识图谱检索可复现证据，返回可追溯来源。（12 项技能）"
            },
            "writing": {
              "type": "boolean",
              "title": "科研写作与出版传播",
              "description": "论文/报告/标书撰写、投稿模板、会议海报与幻灯片、图文表达、文档解析转换。（11 项技能）"
            },
            "stats": {
              "type": "boolean",
              "title": "统计、数据科学与机器学习",
              "description": "统计建模与推断、生存分析、时间序列、图网络、降维、经典 ML、深度学习框架、GNN、强化学习与可解释性、符号计算。（19 项技能）"
            },
            "infra": {
              "type": "boolean",
              "title": "数据工程与计算基础设施",
              "description": "大表/大数组存储、分布式计算、云 GPU 与 HPC 流水线、GPU 加速与资源探测，以及科研 AI/智能体自动化工具。（17 项技能）"
            },
            "singlecell": {
              "type": "boolean",
              "title": "单细胞与转录组分析",
              "description": "单细胞与 bulk 转录组标准链路：数据格式、QC/聚类/降维、RNA velocity、生成式整合、差异表达、通路富集、GRN 推断、群体图谱查询。（10 项技能）"
            },
            "genomics": {
              "type": "boolean",
              "title": "基因组学与序列变异分析",
              "description": "基因组区间与变异处理、比对与文件 I/O、坐标/装配转换、变异存储与人群队列查询、DNA 语言模型、病原体变异监测、肿瘤体细胞流程、系统发生分析。（16 项技能）"
            },
            "chemistry": {
              "type": "boolean",
              "title": "化学信息学与药物发现",
              "description": "小分子与生物大分子建模：化学信息学工具链、药化规则筛选、分子特征化、质谱/组学分析、分子性质与毒性 ML、分子对接、蛋白语言模型、结合实验 API、分子动力学。（14 项技能）"
            },
            "medicine": {
              "type": "boolean",
              "title": "医学、临床与生物医学影像",
              "description": "临床决策支持与报告、治疗与 PK/PD 建模、动物实验严重度评估、DICOM/病理切片/显微影像、神经电生理与生理信号，以及 ELN/LIMS/协议库、实验室机器人自动化与法规合规。（21 项技能）"
            },
            "physics": {
              "type": "boolean",
              "title": "物理、材料、地球与工程仿真",
              "description": "量子计算与量子系统模拟、天文与天体物理、材料结构分析、CFD/PIV/离散事件仿真、多目标工程优化、地理空间与遥感、实验硬件 CAD。（13 项技能）"
            }
          }
        }
      }
    }
  },

{
  "$schema": "https://schemas.vibex.dev/plugin/v4/plugin.schema.json",
  "manifestVersion": 4,
  "apiVersion": "2.0",
  "id": "dimo.session-enhance",
  "publisher": "dimo",
  "version": "2.0.0",
  "name": "会话增强",
  "readme": "README.md",
  "engines": {
    "dimo": ">=0.1.3 <1.0.0",
    "pluginSdk": "^2.0.0"
  },
  "content": {
    "root": "contents",
    "index": ".dimo-plugin/content.index.json"
  },
  "config": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feedback": {
          "title": "实时反馈",
          "description": "在智能体工作时向它发送备注与纠偏。",
          "type": "boolean",
          "default": true
        },
        "question": {
          "title": "向用户提问",
          "description": "允许智能体暂停并向你提出多选问题。",
          "type": "boolean",
          "default": true
        },
        "sessionInfo": {
          "title": "获取会话信息",
          "description": "允许智能体查询你在消息中提及的会话。",
          "type": "boolean",
          "default": true
        },
        "sessionControl": {
          "title": "会话控制",
          "description": "允许向本会话或其子会话发送输入、取消回合或等待结束。",
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "integrations": [
    {
      "id": "dimo-session-enhance",
      "kind": "content.skill",
      "resource": "contents/skills/dimo-session-enhance",
      "targets": [
        "codex",
        "claude-code",
        "acp"
      ]
    },
    {
      "id": "dimo-session-mcp",
      "kind": "content.mcp",
      "resource": "contents/mcps/session.json"
    }
  ],
  "interface": {
    "icon": "assets/icon.svg"
  },
  "entrypoints": {
    "app": {
      "entry": "app/main.js",
      "protocol": "2.0"
    }
  },
  "dependencies": [
    {
      "kind": "plugin",
      "id": "dimo.provider-switch",
      "publisher": "dimo",
      "versionRange": "^1.0.0 || ^2.0.0",
      "required": true
    }
  ]
}

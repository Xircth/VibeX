; VibeX Minimal Installer Localized Strings (SimpChinese + English)
!ifndef VIBEX_INSTALLER_STRINGS
!define VIBEX_INSTALLER_STRINGS

!ifdef LANG_SIMPCHINESE
  LangString VIBEX_CHOOSE_PATH ${LANG_SIMPCHINESE} "选择安装位置"
  LangString VIBEX_BROWSE ${LANG_SIMPCHINESE} "选择"
  LangString VIBEX_INSTALL_NOW ${LANG_SIMPCHINESE} "立即安装"
  LangString VIBEX_REINSTALL ${LANG_SIMPCHINESE} "重新安装"
  LangString VIBEX_UNINSTALL ${LANG_SIMPCHINESE} "卸载"
  LangString VIBEX_CANCEL ${LANG_SIMPCHINESE} "取消"
  LangString VIBEX_LAUNCH_NOW ${LANG_SIMPCHINESE} "立即启动"
  LangString VIBEX_FINISH ${LANG_SIMPCHINESE} "完成"
  LangString VIBEX_UNINSTALLED_DONE ${LANG_SIMPCHINESE} "已完成卸载"
  LangString VIBEX_PROGRESS_PREPARE ${LANG_SIMPCHINESE} "正在准备安装…"
  LangString VIBEX_PROGRESS_EXTRACT ${LANG_SIMPCHINESE} "正在解压文件…"
  LangString VIBEX_PROGRESS_INSTALL ${LANG_SIMPCHINESE} "正在安装文件…"
  LangString VIBEX_PROGRESS_FINISH ${LANG_SIMPCHINESE} "正在完成安装…"
  LangString VIBEX_PROGRESS_UNINSTALL ${LANG_SIMPCHINESE} "正在卸载文件…"
  LangString VIBEX_PATH_INVALID ${LANG_SIMPCHINESE} "请选择有效的本地安装文件夹路径。"
!endif

!ifdef LANG_ENGLISH
  LangString VIBEX_CHOOSE_PATH ${LANG_ENGLISH} "Choose location"
  LangString VIBEX_BROWSE ${LANG_ENGLISH} "Browse"
  LangString VIBEX_INSTALL_NOW ${LANG_ENGLISH} "Install now"
  LangString VIBEX_REINSTALL ${LANG_ENGLISH} "Reinstall"
  LangString VIBEX_UNINSTALL ${LANG_ENGLISH} "Uninstall"
  LangString VIBEX_CANCEL ${LANG_ENGLISH} "Cancel"
  LangString VIBEX_LAUNCH_NOW ${LANG_ENGLISH} "Launch now"
  LangString VIBEX_FINISH ${LANG_ENGLISH} "Finish"
  LangString VIBEX_UNINSTALLED_DONE ${LANG_ENGLISH} "Uninstalled"
  LangString VIBEX_PROGRESS_PREPARE ${LANG_ENGLISH} "Preparing installation…"
  LangString VIBEX_PROGRESS_EXTRACT ${LANG_ENGLISH} "Extracting files…"
  LangString VIBEX_PROGRESS_INSTALL ${LANG_ENGLISH} "Installing files…"
  LangString VIBEX_PROGRESS_FINISH ${LANG_ENGLISH} "Finishing installation…"
  LangString VIBEX_PROGRESS_UNINSTALL ${LANG_ENGLISH} "Uninstalling files…"
  LangString VIBEX_PATH_INVALID ${LANG_ENGLISH} "Please choose a valid local installation folder path."
!endif

!endif
